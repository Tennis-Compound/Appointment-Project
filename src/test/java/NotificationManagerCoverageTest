import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.Test;

public class NotificationManagerCoverageTest {

    @Test
    void shouldCreateNotificationManager() {
        NotificationService service = new MockNotificationService();
        NotificationManager manager = new NotificationManager(service);

        assertNotNull(manager);
    }

    @Test
    void shouldSendBookingConfirmationWithoutException() {
        NotificationService service = new MockNotificationService();
        NotificationManager manager = new NotificationManager(service);

        assertDoesNotThrow(() ->
            manager.sendBookingConfirmation(
                "test@test.com",
                "Appointment on Monday"
            )
        );
    }

    @Test
    void shouldSendCancellationNoticeWithoutException() {
        NotificationService service = new MockNotificationService();
        NotificationManager manager = new NotificationManager(service);

        assertDoesNotThrow(() ->
            manager.sendCancellationNotice(
                "test@test.com",
                "Cancelled appointment"
            )
        );
    }

    @Test
    void shouldSendModificationNoticeWithoutException() {
        NotificationService service = new MockNotificationService();
        NotificationManager manager = new NotificationManager(service);

        assertDoesNotThrow(() ->
            manager.sendModificationNotice(
                "test@test.com",
                "Old Details",
                "New Details"
            )
        );
    }

    @Test
    void shouldCancelReminderWithoutException() {
        NotificationService service = new MockNotificationService();
        NotificationManager manager = new NotificationManager(service);

        assertDoesNotThrow(() -> manager.cancelReminder(1));
    }
}
