    @Test
    void testBookAppointmentSuccess() throws Exception {
        setStaticField(Appoitment_Main_Page.class, "loggedInUserId", 1);
        Connection conn = mockConn();
        stubEmptySlots(conn); // viewAvailableSlots

        // checkStmt: slot IS available
        PreparedStatement checkStmt = mock(PreparedStatement.class);
        ResultSet slotRs = mock(ResultSet.class);
        when(slotRs.next()).thenReturn(true);
        when(slotRs.getTimestamp("start_datetime")).thenReturn(future());
        when(slotRs.getTimestamp("end_datetime")).thenReturn(future());
        when(checkStmt.executeQuery()).thenReturn(slotRs);

        // bookStmt: returns appointment_id
        PreparedStatement bookStmt = mock(PreparedStatement.class);
        ResultSet bookRs = mock(ResultSet.class);
        when(bookRs.next()).thenReturn(true);
        when(bookRs.getInt("appointment_id")).thenReturn(99);
        when(bookStmt.executeQuery()).thenReturn(bookRs);

        // updateStmt: mark slot unavailable
        PreparedStatement updateStmt = mock(PreparedStatement.class);

        // userStmt: get email
        PreparedStatement userStmt = mock(PreparedStatement.class);
        ResultSet userRs = mock(ResultSet.class);
        when(userRs.next()).thenReturn(true);
        when(userRs.getString("email")).thenReturn("user@test.com");
        when(userStmt.executeQuery()).thenReturn(userRs);

        when(conn.prepareStatement(anyString()))
                .thenReturn(checkStmt)
                .thenReturn(bookStmt)
                .thenReturn(updateStmt)
                .thenReturn(userStmt);

        // type=1 URGENT, duration=20, 1 participant, no location
        invoke("bookAppointment", new Class[]{Scanner.class}, sc("1\n1\n20\n1\n\n"));
        assertTrue(outContent.toString().contains("Appointment booked successfully!"));
    }

