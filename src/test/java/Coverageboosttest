    @Test
    void testModifyAppointmentSuccess() throws Exception {
        setStaticField(Appoitment_Main_Page.class, "loggedInUserId", 1);
        Connection conn = mockConn();

        PreparedStatement viewPs   = mock(PreparedStatement.class);
        PreparedStatement getPs    = mock(PreparedStatement.class);
        PreparedStatement checkPs  = mock(PreparedStatement.class);
        PreparedStatement updatePs = mock(PreparedStatement.class);
        PreparedStatement freePs   = mock(PreparedStatement.class);
        PreparedStatement bookPs   = mock(PreparedStatement.class);

        ResultSet emptyRs = mock(ResultSet.class);
        ResultSet apptRs  = mock(ResultSet.class);
        ResultSet slotRs  = mock(ResultSet.class);

        when(emptyRs.next()).thenReturn(false);
        when(viewPs.executeQuery()).thenReturn(emptyRs);

        when(apptRs.next()).thenReturn(true);
        when(apptRs.getInt("slot_id")).thenReturn(1);
        when(apptRs.getString("email")).thenReturn("u@test.com");
        when(apptRs.getString("name")).thenReturn("User");
        when(apptRs.getString("appointment_type")).thenReturn("ASSESSMENT");
        when(apptRs.getTimestamp("start_datetime")).thenReturn(future());
        when(apptRs.getTimestamp("end_datetime")).thenReturn(future());
        when(getPs.executeQuery()).thenReturn(apptRs);

        when(slotRs.next()).thenReturn(true);
        when(slotRs.getBoolean("is_available")).thenReturn(true);
        when(slotRs.getTimestamp("start_datetime")).thenReturn(future());
        when(slotRs.getTimestamp("end_datetime")).thenReturn(future());
        when(checkPs.executeQuery()).thenReturn(slotRs);

        when(updatePs.executeUpdate()).thenReturn(1); // rowsUpdated > 0

        Statement slotsStmt = mock(Statement.class);
        ResultSet slotsRs = mock(ResultSet.class);
        when(conn.createStatement()).thenReturn(slotsStmt);
        when(slotsStmt.executeQuery(anyString())).thenReturn(slotsRs);
        when(slotsRs.next()).thenReturn(false);

        when(conn.prepareStatement(anyString()))
                .thenReturn(viewPs)
                .thenReturn(getPs)
                .thenReturn(checkPs)
                .thenReturn(updatePs)
                .thenReturn(freePs)
                .thenReturn(bookPs);

        invoke("modifyAppointment", new Class[]{Scanner.class}, sc("1\n2\n"));
        assertTrue(outContent.toString().contains("Appointment modified successfully!"));
