import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.Test;

public class BookingRuleFactoryCoverageTest {

    @Test
    void shouldReturnUrgentRule() {
        assertTrue(BookingRuleFactory.getRule("URGENT") instanceof UrgentBookingRule);
    }

    @Test
    void shouldReturnFollowUpRule() {
        assertTrue(BookingRuleFactory.getRule("FOLLOW_UP") instanceof FollowUpBookingRule);
    }

    @Test
    void shouldReturnAssessmentRule() {
        assertTrue(BookingRuleFactory.getRule("ASSESSMENT") instanceof AssessmentBookingRule);
    }

    @Test
    void shouldReturnVirtualRule() {
        assertTrue(BookingRuleFactory.getRule("VIRTUAL") instanceof VirtualBookingRule);
    }

    @Test
    void shouldReturnInPersonRule() {
        assertTrue(BookingRuleFactory.getRule("IN_PERSON") instanceof InPersonBookingRule);
    }

    @Test
    void shouldReturnIndividualRule() {
        assertTrue(BookingRuleFactory.getRule("INDIVIDUAL") instanceof IndividualBookingRule);
    }

    @Test
    void shouldReturnGroupRule() {
        assertTrue(BookingRuleFactory.getRule("GROUP") instanceof GroupBookingRule);
    }

    @Test
    void shouldReturnNullForInvalidRule() {
        assertNull(BookingRuleFactory.getRule("INVALID"));
    }
}
